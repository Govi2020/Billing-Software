NODE_ENV=development
PORT=4000

# Local PostgreSQL and Redis
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brightloop
REDIS_URL=redis://localhost:6379

# Local frontend and API
FRONTEND_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000/api/v1
BUSINESS_TIMEZONE=Asia/Kolkata

# Replace with a private random secret of at least 32 characters
JWT_SECRET=replace-this-with-a-private-random-secret-at-least-32-characters
JWT_KEY_ID=primary
JWT_PREVIOUS_KEYS={}
JWT_ISSUER=brightloop-api
JWT_AUDIENCE=brightloop-client
REFRESH_COOKIE_NAME=brightloop_refresh
COOKIE_SECURE=false

# Demo account password; 9+ characters with uppercase, lowercase, and symbol
DEMO_SEED_PASSWORD=ReplaceMe!2026

# Optional Brevo API email delivery
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Brightloop Software

# Optional SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional customer UPI payment links (use a valid payee ID)
PAYMENT_UPI_ID=
PAYMENT_PAYEE_NAME=Brightloop Software

# Demo-only fake payment flow. Never enable in production.
DEMO_PAYMENTS_ENABLED=true

LOG_LEVEL=info
