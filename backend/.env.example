FRONTEND_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
JWT_SECRET=
JWT_KEY_ID=primary
JWT_PREVIOUS_KEYS={}
